# Plantilla — copiar a `.env` y rellenar. El archivo .env está gitignorado.

# 2captcha account API key (https://2captcha.com/enterpage)
# Usado para obtener el whitelist de proxies residenciales.
TWOCAPTCHA_API_KEY=

# Proxy pool config (opcional — si se omite, se usa conexión directa)
PROXY_ENABLED=false                # true | false
PROXY_COUNTRY=co                   # ISO 2-letter (co, us, mx, ...)
PROXY_PROTOCOL=                    # http | https | socks5  (vacío = todos, mejor fallback)
PROXY_POOL_SIZE=10                 # 1-50
PROXY_REFRESH_MINUTES=30           # cada cuánto refrescar el whitelist

# Por defecto solo SISPRO (sispro_aspx) usa proxy — Socrata y REPS no lo necesitan.
# Para forzar otra mezcla:  PROXY_USE_FOR_KINDS=sispro_aspx,reps_export
# Vacío explícito = ninguna fuente usa proxy:  PROXY_USE_FOR_KINDS=
# PROXY_USE_FOR_KINDS=sispro_aspx

# Socrata app token — opcional, sube rate limit de ~1k/h a ~100k/h
SALUD_SOCRATA_APP_TOKEN=

# Override del directorio de catálogos (default: ./catalogos_co)
# SALUD_CATALOGS_ROOT=./catalogos_co
